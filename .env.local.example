# ============================================================
# InterviewAce AI - Environment Variables
# Copy this file to .env.local and fill in your values
# ============================================================

# ── Firebase Client (Public - safe to expose) ───────────────
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# ── Firebase Admin SDK (Server-only - NEVER expose) ─────────
# Get these from Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Replace literal \n with actual newlines when setting in production
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"

# ── Google Gemini API ────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
# In production, retrieve this from Google Cloud Secret Manager
GEMINI_API_KEY=your-gemini-api-key

# ── Application ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Google Cloud (for Cloud Run deployment) ──────────────────
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
